# TinyNest Fire TV Environment Configuration
# For Android Studio emulator: use 10.0.2.2 (points to Windows host machine)
# For Physical Fire TV device: use your Windows machine LAN IP, e.g. http://192.168.1.100:5000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
EXPO_PUBLIC_DEVICE_ID=tinynest-firetv-livingroom

    fontWeight: '800',
  },
  stars: {flexDirection: 'row', gap: 36, marginTop: 20},
  star: {color: '#B8A7FF', fontSize: 22},
  glassCard: {
    width: '80%',
    maxWidth: 700,
    alignItems: 'center',
    paddingHorizontal: 34,

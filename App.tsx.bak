    borderWidth: 1,
    borderColor: '#365B87',
  },
  durationText: {color: '#EAF3FF', fontSize: 12, fontWeight: '900'},
  stopLessonButton: {
    paddingHorizontal: 18,
    paddingVertical: 13,
    borderRadius: 12,

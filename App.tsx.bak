    fontWeight: '900',
    letterSpacing: 1.4,
  },
  timerValue: {
    color: '#FFFFFF',
    fontSize: 25,
    fontWeight: '900',
    fontVariant: ['tabular-nums'],
  },
  lessonBar: {
    minHeight: 72,
    flexDirection: 'row',
    alignItems: 'center',

  controls: {flexDirection: 'row', gap: 14, marginTop: 14, minHeight: 82},
  modeButton: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    gap: 12,
    borderWidth: 1,
    borderRadius: 17,
    paddingHorizontal: 17,
    paddingVertical: 13,
  },
  mode_purple: {backgroundColor: '#211D38', borderColor: '#554878'},
  mode_teal: {backgroundColor: '#12312F', borderColor: '#2B7770'},
  mode_blue: {backgroundColor: '#172945', borderColor: '#355D91'},
  focusedMode: {
    borderColor: '#FFFFFF',
    borderWidth: 3,
    transform: [{scale: 1.025}],
  },
  modeEmoji: {fontSize: 28},
  modeCopy: {flex: 1},
  modeTitle: {
    color: '#F4F7FF',
